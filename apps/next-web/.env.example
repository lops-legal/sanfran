# Copie este arquivo para `.env.local` (não versionado) e preencha com
# as credenciais reais do seu projeto Supabase (Settings → API).
#
# Sem essas variáveis o app cai em fallback de chave placeholder e o auth
# (login/sessão persistente) não funciona.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica
