# Supabase (obrigatório para auth e escrita de skills)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend FastAPI para chat Lex (opcional em dev)
LEX_BACKEND_URL=http://localhost:8000/api/lex-chat

# Chave de criptografia para dados sensíveis no servidor (opcional)
ENCRYPTION_KEY=

# Habilita cron de retenção diária — requer bash (Linux/macOS)
ENABLE_RETENTION_CRON=false

# Ambiente
NODE_ENV=development
